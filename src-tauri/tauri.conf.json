{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BCRM WinStore",
  "version": "0.1.0",
  "identifier": "com.bcrm.winget",
  "build": {
    "beforeDevCommand": "npm.cmd run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm.cmd run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BCRM WinStore",
        "width": 1360,
        "height": 840,
        "minWidth": 1280,
        "minHeight": 720,
        "center": true,
        "visible": false,
        "backgroundColor": "#09090b",
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
